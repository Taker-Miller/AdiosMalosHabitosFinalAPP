<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp"
    android:background="@color/purple_dark">

    <!-- Spinner para seleccionar el hábito -->
    <TextView
        android:id="@+id/habitoSeleccionadoTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Selecciona el Hábito"
        android:textSize="20sp"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:fontFamily="@font/roboto_medium"
        android:layout_marginBottom="8dp" />

    <Spinner
        android:id="@+id/habitoSpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:padding="8dp"
        android:background="@drawable/spinner_background" />



    <!-- Spinner para seleccionar el mes -->
    <TextView
        android:id="@+id/mesSeleccionadoTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Selecciona el Mes"
        android:textSize="20sp"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:fontFamily="@font/roboto_medium"
        android:layout_marginBottom="8dp" />

    <Spinner
        android:id="@+id/mesSpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:padding="8dp"
        android:background="@drawable/spinner_background" />

    <!-- Calendario con fondo sólido -->
    <CalendarView
        android:id="@+id/calendarioMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@color/white" />

    <!-- Estado del día con fondo estilizado -->
    <TextView
        android:id="@+id/estadoDiaTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Estado del Día"
        android:textSize="18sp"
        android:padding="12dp"
        android:textColor="@color/text_color_secondary"
        android:background="@drawable/textview_background"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:textStyle="bold"
        android:fontFamily="@font/roboto_medium"
        android:elevation="4dp" />

</LinearLayout>
